PORT=5000
NODE_ENV=development

# Opción A (Dokploy): URL de conexión interna de la base Postgres
# DATABASE_URL=postgresql://usuario:password@host:5432/fuel_recorder
# Opción B: variables separadas (se ignoran si DATABASE_URL está definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuel_recorder
DB_USER=postgres
DB_PASSWORD=your_password
# true solo si la base exige SSL (no hace falta con la red interna de Dokploy)
DB_SSL=false

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# Orígenes permitidos separados por comas (vacío = cualquiera)
CORS_ORIGIN=

# Se usa solo si no existe ningún admin en la base
ADMIN_FICHA=ADMIN001
ADMIN_PASSWORD=admin123

# Cierre automático del reporte diario (hora local HH:MM y zona horaria)
REPORTE_HORA_CIERRE=17:00
TZ=America/Santo_Domingo
